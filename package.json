{
  "name": "tslprb",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:mobile": "pnpm --filter mobile start",
    "dev:web": "pnpm --filter web dev",
    "web:mobile": "pnpm --filter mobile web",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "doctor": "pnpm --filter mobile exec npx --yes expo-doctor",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f web api worker",
    "docker:build": "docker compose build",
    "docker:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build",
    "api:up": "docker compose up -d postgres redis api worker",
    "api:down": "docker compose down",
    "api:logs": "docker compose logs -f api worker",
    "api:migrate": "docker compose exec api alembic upgrade head",
    "api:export-tests": "pnpm --filter web exec tsx ../../services/api/scripts/export_test_bank.ts",
    "api:check-tests": "pnpm --filter web exec tsx ../../services/api/scripts/export_test_bank.ts --check",
    "contracts:gen": "pnpm --filter @tslprb/api-contracts gen"
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "typescript": "~6.0.3"
  }
}

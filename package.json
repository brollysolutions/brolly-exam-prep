{
  "name": "tslprb",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:mobile": "pnpm --filter mobile start",
    "dev:web": "pnpm --filter web dev",
    "web:mobile": "pnpm --filter mobile web",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "doctor": "pnpm --filter mobile exec expo-doctor",
    "api:up": "docker compose --profile dev up -d",
    "api:down": "docker compose --profile dev down",
    "api:logs": "docker compose --profile dev logs -f api worker",
    "api:migrate": "docker compose --profile dev exec api alembic upgrade head",
    "contracts:gen": "pnpm --filter @tslprb/api-contracts gen"
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "typescript": "~6.0.3"
  }
}

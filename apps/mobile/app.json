{
  "expo": {
    "name": "Telangana Police Constable & SI Exam Preparation",
    "slug": "tslprb-prep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tslprb",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.telanganapoliceexampreparation.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#0a1e3a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7f2e6",
          "image": "./assets/brand/splash-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#f7f2e6"
  }
}

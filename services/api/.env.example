# Copy to .env and adjust as needed. All values below are the defaults used
# by app/config.py when a variable is not set.

# Postgres connection used by SQLAlchemy (async driver) and Alembic.
DATABASE_URL=postgresql+asyncpg://tslprb:tslprb@localhost:5432/tslprb

# Redis connection used by arq (worker queue + cron scheduler).
REDIS_URL=redis://localhost:6379/0

# When true, OTP codes are always OTP_DEV_CODE and no SMS provider is used.
OTP_DEV_MODE=true
OTP_DEV_CODE=123456

# CORS: comma-separated list of allowed origins, or * for all (dev only).
CORS_ORIGINS=*

# Secret used to sign opaque session tokens issued at /v1/otp/verify.
JWT_SECRET=dev-secret-change-me

ENV=dev
